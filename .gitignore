# Allow-list .gitignore — everything ignored unless explicitly un-ignored.

*
!.gitignore
!.gitattributes
!.metadata
!analysis_options.yaml
!pubspec.yaml
!README.adoc
!CHANGELOG.adoc
!LICENSE
!LICENSE.*

!lib/
!lib/**

!src/
!src/**

!cmake/
!cmake/**

!windows/
!windows/**

!linux/
!linux/**

!example/
!example/**

# Re-ignore build artifacts and IDE junk inside allow-listed trees
**/.dart_tool/
**/build/
**/.flutter-plugins-dependencies
**/doc/api/
**/coverage/
**/native/prebuilt/
**/*.iml
**/.idea/
**/.vscode/
**/pubspec.lock
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/